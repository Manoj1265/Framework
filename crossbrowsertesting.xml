<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" thread-count="5" parallel="tests">

	<listeners>
		<listener class-name="utilities.ExtentReportManager"></listener>
	</listeners>

	<test name="chrometest">
		<parameter name="os" value="Windows"></parameter>
		<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="testCases.LoginTests" />
		</classes>
	</test> <!-- Test -->

	<test name="edgetest">
		<parameter name="os" value="Windows"></parameter>
		<parameter name="browser" value="edge"></parameter>
		<classes>
			<class name="testCases.LoginTests" />
		</classes>
	</test> <!-- Test -->

	<test name="firefoxtest"><!-- Mostly Test got skipped in cross browser testing via selenium grid as firefox takes 
	longer time to initiate. Better to create another xml file for cross browser test for selenium grid excluding firefox.-->
		<parameter name="os" value="Windows"></parameter>
		<parameter name="browser" value="firefox"></parameter>
		<classes>
			<class name="testCases.LoginTests" />
		</classes>
	</test> <!-- Test -->

</suite> <!-- Suite -->