<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Master Suite">
	<parameter name="browser" value="edge"></parameter> <!--Global variable -->
	<!--Global vriable works only when relavant parameter is not available in Test tag locally -->

	<listeners>
		<listener class-name="utilities.ExtentReportManager"></listener>
	</listeners>

	<test name="Linux-Chrome">
		<parameter name="os" value="Linux"></parameter>
		<parameter name="browser" value="chrome"></parameter>
		
		<classes>
			<class name="testCases.LoginTests" />
			<class name="testCases.TC02LoginWithCorrectUserAndPassword" />
		</classes>
	</test> 
	
	<test name="Linux-Firefox">
		<parameter name="os" value="Linux"></parameter>
		<parameter name="browser" value="firefox"></parameter>
		
		<classes>
			<class name="testCases.LoginTests" />
			<class name="testCases.TC02LoginWithCorrectUserAndPassword" />
		</classes>
	</test> 

</suite> <!-- Suite -->